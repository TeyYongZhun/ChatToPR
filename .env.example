# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored by Next.js by default — never commit real secrets.

# Personal Access Token for GitHub (used by @octokit/rest in /api/triage)
# Required scopes: repo (to read/write code and open pull requests)
GITHUB_PAT=ghp_your_personal_access_token_here
GITHUB_OWNER=TeyYongZhun
GITHUB_REPO=ChatToPR_sandbox